{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "KPI diarios - enero 2024",
      "queryLines": [
        "SELECT pickup_date, total_trips, total_revenue, avg_trip_distance, avg_trip_duration_minutes, avg_tip_percentage\n",
        "FROM databricks_course.gold.daily_kpis\n",
        "WHERE pickup_date BETWEEN DATE '2024-01-01' AND DATE '2024-01-31'\n",
        "ORDER BY pickup_date"
      ]
    },
    {
      "name": "ds_zones",
      "displayName": "Rendimiento por zona",
      "queryLines": [
        "SELECT pickup_borough, pickup_zone, total_pickups, total_revenue, avg_ticket, avg_distance\n",
        "FROM databricks_course.gold.zone_performance\n",
        "ORDER BY total_pickups DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_payments",
      "displayName": "Métodos de pago",
      "queryLines": [
        "SELECT CAST(payment_type AS STRING) AS payment_type, total_trips, total_revenue, avg_tip\n",
        "FROM databricks_course.gold.payment_summary\n",
        "ORDER BY total_trips DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Resumen ejecutivo",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# NYC Yellow Taxi - Enero 2024\n",
                "\n",
                "Arquitectura medallion en Azure Databricks: indicadores de demanda, ingresos, zonas y métodos de pago."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi-total-trips",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "sum(total_trips)",
                      "expression": "SUM(`total_trips`)"
                    },
                    {
                      "name": "daily(pickup_date)",
                      "expression": "DATE_TRUNC(\"DAY\", `pickup_date`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(total_trips)",
                  "displayName": "Viajes",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                },
                "period": {
                  "fieldName": "daily(pickup_date)"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Total de viajes"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "kpi-total-revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
